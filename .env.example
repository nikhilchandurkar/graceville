# =====================================================================
# Grace Ville - Environment Configuration Template (.env.example)
# Copy these keys into your Vercel Project Settings -> Environment Variables
# =====================================================================

SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# WhatsApp & Contact Numbers
WHATSAPP_PHONE=917768956163
OWNER_PHONE=919699825732

# Free Gmail SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Grace Ville Reservations <your-email@gmail.com>

# Notification Receiver Email (Supports comma-separated emails, e.g. graceville1911@gmail.com,owner@gmail.com)
NOTIFICATION_RECEIVER_EMAIL=graceville1911@gmail.com
CONTACT_EMAIL=graceville1911@gmail.com

# Free MongoDB Atlas Cloud Persistence (M0 Free Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.359hp4b.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=graceville_db

# Django Admin Superuser Credentials (Optional: set in Vercel Environment Variables to secure the admin portal)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=your-custom-secure-admin-password
DJANGO_SUPERUSER_EMAIL=admin@graceville.in

